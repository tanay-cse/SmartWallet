# ─────────────────────────────────────────────────────────────────────────────
# SmartWallet — Environment Variables
# Copy this file to .env and fill in real values locally.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (via Prisma)
DATABASE_URL=

# Redis connection string
REDIS_URL=

# JWT signing secrets
JWT_SECRET=
JWT_REFRESH_SECRET=

# AES encryption key for stored card data
CARD_ENCRYPTION_KEY=

# Anthropic API key (AI card-recommendation assistant)
ANTHROPIC_API_KEY=

# Market / forex data provider API key
MARKET_DATA_API_KEY=
